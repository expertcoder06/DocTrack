# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- MongoDB ----
# Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/doctrack
# MongoDB Atlas:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/doctrack?retryWrites=true&w=majority

# ---- Redis ----
# Either standard REDIS_URL:
REDIS_URL=rediss://default:your-token@your-host.upstash.io:6379
# Or Upstash credentials (auto-resolved by config/env.ts):
UPSTASH_REDIS_REST_URL=https://your-host.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ---- JWT ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- CORS ----
CLIENT_ORIGIN=http://localhost:5173
# Optional: comma-separated allowlist (preferred for deployment)
# CLIENT_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
